# Essai du serveur : groupes, droits sur ses fiches, rôles qui changent.
serveur "commerce" :
    roles gerant, vendeur et client
    document "recu" de commande :
        titre "Reçu {commande.id}"
        texte "Total : {commande.total} euros"
    toutes les heures :
        creer journal avec nom "heure"
    donnee commande par boutique :
        total : nombre
        statut : texte au depart "ouverte"
    donnee message par compte :
        texte : texte
    donnee journal :
        nom : texte
    donnee suivi par boutique :
        total : nombre
    donnee facture :
        montant : nombre
        clients : liste de texte
    route "commandes" :
        seuls gerant et vendeur peuvent lire commande
        seuls gerant et vendeur peuvent creer commande
        seul gerant peut modifier commande
        seul gerant peut supprimer commande
        seul gerant peut faire "rembourser" sur commande :
            si commande.statut est egal a "remboursee" :
                refuser "Déjà remboursée"
            changer commande.statut par "remboursee"
            creer suivi avec total commande.total
            si commande.total est superieur a 1000 :
                refuser "Trop cher pour un remboursement"
    route "suivis" :
        seul gerant peut lire suivi
        seul gerant peut modifier suivi
    route "journaux" :
        connecte peut lire journal
        seul admin peut modifier journal
    route "messages" :
        connecte peut lire message
        connecte peut creer message
        connecte peut supprimer message
    route "factures" :
        seul gerant peut lire facture
        client peut lire facture si utilisateur.id est dans facture.clients
        seul gerant peut modifier facture
    route "equipe" :
        seul admin peut lire comptes

page "accueil" :
    variable commandes = []
    titre "Commerce"
    quand la page se charge :
        envoyer requete vers "commandes" dans commandes en direct
    bouton "Promouvoir"
    quand l'utilisateur clique sur "Promouvoir" :
        changer role de "abc" en "gerant"
    bouton "Rembourser"
    quand l'utilisateur clique sur "Rembourser" :
        faire "rembourser" sur commandes
