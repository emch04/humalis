# Le catalogue : une liste de produits, et une page par produit, à
# l'adresse /produit/<son identifiant> (trou G3).
serveur "boutique" :
    donnee produit :
        nom : texte
        prix : nombre
    route "produits" :
        tout le monde peut lire produit
        seul admin peut modifier produit

page "catalogue" :
    variable produits = []
    titre "Le catalogue"
    quand la page se charge :
        envoyer requete vers "produits" dans produits
    pour chaque p dans produits :
        lien p.nom vers "produit" avec id p.id

page "produit" avec parametre id :
    variable produit = rien
    quand la page se charge :
        envoyer requete vers "produits" avec id dans produit
    si produit est rien :
        texte "Chargement du produit…"
    sinon :
        titre produit.nom
        texte "{produit.prix} €"
    lien "Retour au catalogue" vers "catalogue"
