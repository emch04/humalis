{
  "name": "humalis",
  "version": "2.0.0",
  "description": "Un seul langage, en français, pour créer une application complète : site web, applications Apple, Android, Windows et Linux, et leur serveur",
  "type": "module",
  "bin": {
    "humalis": "dist/cli.js"
  },
  "files": [
    "dist",
    "llms.txt",
    "NOTICE",
    "LICENSE.en.md",
    "README.en.md",
    "docs/guide.md",
    "docs/guide.en.md",
    "docs/logo/humalis-logo.svg",
    "docs/logo/humalis-logo-carte.svg",
    "docs/logo/humalis-logo-sombre.svg"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && rolldown dist/navigateur.js --format esm --minify --file dist/navigateur.js && node scripts/construire-editeur.mjs",
    "test": "vitest run",
    "test:postgres": "vitest run tests/serveur-attaques.test.ts tests/serveur-attaques-calculs.test.ts tests/serveur-attaques-groupes.test.ts tests/serveur-attaques-temps-reel.test.ts tests/serveur-inscription-libre.test.ts tests/serveur-suppression-compte.test.ts tests/serveur-sauvegarde-postgres.test.ts",
    "typecheck": "tsc --noEmit",
    "essai:web": "node scripts/essai-web.mjs",
    "essai:editeur": "node scripts/essai-editeur.mjs",
    "essai:react-hote": "node scripts/essai-react-hote.mjs",
    "essai:serveur": "node scripts/essai-serveur.mjs",
    "essai:lien": "node scripts/essai-lien.mjs",
    "essai:windows": "node scripts/essai-windows.mjs",
    "essai:temps-reel": "node scripts/essai-temps-reel.mjs",
    "essai:reunions": "node scripts/essai-reunions.mjs",
    "essai:packs": "npm run essai:serveur && npm run essai:lien && npm run essai:connexion && npm run essai:gestion && npm run essai:catalogue && npm run essai:web",
    "essai:connexion": "node scripts/essai-connexion.mjs",
    "essai:gestion": "node scripts/essai-gestion.mjs",
    "essai:catalogue": "node scripts/essai-catalogue.mjs",
    "essai:statique": "node scripts/essai-statique.mjs",
    "essai:moteur": "node scripts/essai-moteur.mjs",
    "essai:moteur-comptes": "node scripts/essai-moteur-comptes.mjs",
    "essai:donnees": "node scripts/essai-donnees-comptes.mjs",
    "essai:donnees-bureau": "node scripts/essai-donnees-bureau.mjs",
    "essai:donnees-apple": "node scripts/essai-apple-donnees.mjs",
    "essai:donnees-android": "node scripts/essai-donnees-android.mjs",
    "essai:moteur-direct": "node scripts/essai-moteur-direct.mjs",
    "essai:endurance": "node scripts/essai-endurance.mjs",
    "essai:moteur-roles": "node scripts/essai-moteur-roles.mjs",
    "essai:serveur-metier": "node scripts/essai-serveur-metier.mjs",
    "essai:charge-serveur": "node scripts/essai-charge-serveur.mjs",
    "essai:web-appareil": "node scripts/essai-web-appareil.mjs",
    "mesure:moteur": "node scripts/mesure-moteur.mjs",
    "essai:sources": "node scripts/essai-sources.mjs",
    "essai:navigation": "node scripts/essai-navigation.mjs",
    "essai:desktop": "node scripts/essai-desktop.mjs",
    "essai:apple": "node scripts/essai-apple.mjs",
    "essai:apple:parcours": "node scripts/essai-apple-parcours.mjs",
    "essai:apple:fonctions": "node scripts/essai-apple-fonctions.mjs",
    "essai:apple:capacites": "node scripts/essai-apple-capacites.mjs",
    "essai:apple:appareil": "node scripts/essai-apple-appareil.mjs",
    "essai:apple:fond": "node scripts/essai-apple-fond.mjs",
    "essai:apple:dessin": "node scripts/essai-apple-dessin.mjs",
    "essai:apple:connexion": "node scripts/essai-serveur-apple.mjs",
    "essai:apple:natifs": "node scripts/essai-apple-natifs.mjs",
    "essai:android": "node scripts/essai-android.mjs",
    "essai:limites-natives": "node scripts/essai-limites-natives.mjs",
    "essai:formulaire": "node scripts/essai-formulaire.mjs",
    "essai:vitrine": "node scripts/essai-vitrine.mjs",
    "site:doc": "node scripts/doc-site.mjs",
    "site:antiseche": "node scripts/antiseche-site.mjs",
    "site:licence": "node scripts/licence-site.mjs",
    "site:exemples": "node scripts/exemples-site.mjs",
    "verifier:produit": "node scripts/verifier-code-produit.mjs",
    "verifier:serveurs": "node scripts/verifier-serveurs-exemples.mjs",
    "verifier:natifs": "node scripts/verifier-natifs.mjs",
    "llms": "node --disable-warning=ExperimentalWarning --experimental-loader ./scripts/charger-typescript.mjs scripts/generer-llms.mjs",
    "essai:medias": "node scripts/essai-medias.mjs",
    "essai:interactions": "node scripts/essai-interactions.mjs",
    "essai:langues": "node scripts/essai-langues.mjs",
    "essai:graphiques": "node scripts/essai-graphiques.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "humalis",
    "langage",
    "langage de programmation",
    "français",
    "compilateur",
    "swiftui",
    "android",
    "windows",
    "electron",
    "site statique",
    "language",
    "compiler",
    "french"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "emch04",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emch04/humalis.git"
  },
  "homepage": "https://humalis.dev",
  "bugs": {
    "url": "https://github.com/emch04/humalis/issues"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "rolldown": "1.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
