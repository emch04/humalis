{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "[", "close": "]", "notIn": ["string", "comment"] },
    { "open": "{", "close": "}", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["[", "]"],
    ["{", "}"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^[^#]*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^(?!)$"
  },
  "onEnterRules": [
    {
      "beforeText": "^[^#]*:\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "wordPattern": "[A-Za-zÀ-ÿ_][A-Za-zÀ-ÿ0-9_]*"
}
