<!-- Le débogueur des applications Android produites par Humalis : chargé avec le débogueur Java (Android Studio, IntelliJ IDEA). -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Le clic dans la marge d'un fichier .humalis pose un point d'arrêt. -->
        <xdebugger.breakpointType implementation="dev.humalis.intellij.debogueur.PointArretHumalisType"/>
        <debugger.javaBreakpointHandlerFactory implementation="dev.humalis.intellij.debogueur.PointArretHumalisHandlerFactory"/>
        <!-- La strate « Humalis » des classes (JSR-45) : lignes Humalis ↔ code produit. -->
        <debugger.positionManagerFactory implementation="dev.humalis.intellij.debogueur.HumalisPositionManagerFactory" order="last"/>
        <!-- Le pas à pas ne montre pas le code produit appelé par une ligne Humalis. -->
        <debugger.extraSteppingFilter implementation="dev.humalis.intellij.debogueur.PasAPasHumalis"/>
        <projectService serviceImplementation="dev.humalis.intellij.debogueur.TablesDuProjet"/>
    </extensions>
    <projectListeners>
        <!-- Chaque session de débogage : retenir si le programme est arrêté sur une ligne Humalis. -->
        <listener class="dev.humalis.intellij.debogueur.DebutPasHumalis" topic="com.intellij.debugger.impl.DebuggerManagerListener"/>
    </projectListeners>
</idea-plugin>
