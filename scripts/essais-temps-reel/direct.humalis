# L'essai du temps réel sur toutes les cibles : chaque appareil ajoute une note, tous la voient.
serveur "notes" :
    donnee note :
        texte : texte
    route "notes" :
        tout le monde peut lire note
        tout le monde peut creer note

page "accueil" :
    variable notes = []
    titre "Notes en direct"
    formulaire "Nouvelle note" :
        champ "texte" avec obligatoire
        bouton "Ajouter"
    quand le formulaire "Nouvelle note" est soumis :
        envoyer requete vers "notes" avec champ "texte"
        vider champ "texte"
    quand la page se charge :
        envoyer requete vers "notes" dans notes en direct
    si notes est vide :
        texte "Aucune note"
    pour chaque n dans notes :
        texte n.texte
