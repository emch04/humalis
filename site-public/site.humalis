# Site public de Humalis. Les métadonnées et le thème précèdent les langues.
# L'en-tête et le pied sont communs ; la page accueil suit les sections de la maquette.
# Les classes CSS donnent la mise en page ; seul l'éditeur du bac à sable utilise React.
utiliser style "./site.css"
utiliser composant "EditeurHumalis" depuis "./composants/EditeurHumalis"
utiliser fichier "./documentation.humalis"

site :
    nom "Humalis"
    logo "./logo.png"
    description "Humalis, le langage en français qui transforme un seul fichier en applications web, mobile, bureau, site statique et serveur."

traductions anglais :
    "Humalis" : "Humalis"
    "Écris ton application comme une phrase avec Humalis : découvre le langage, ses cinq cibles et ses possibilités." : "Write your app like a sentence with Humalis: discover the language, its five targets and what it can do."
    "Humalis, le langage en français qui transforme un seul fichier en applications web, mobile, bureau, site statique et serveur." : "Humalis, the French language that turns one file into web, mobile, desktop, static site and server applications."

theme :
    couleur marque clair "#c1e928" sombre "#d7ff3a"
    police titres "Space Grotesk" depuis "./polices/space-grotesk.woff2"
    police texte "Inter" depuis "./polices/inter.woff2"
    police code "JetBrains Mono" depuis "./polices/jetbrains-mono.woff2"
    mode sombre
    largeur large

langues :
    francais
    anglais

entete avec colle et style "site-header" :
    ligne avec style "nav-row" :
        lien "humalis" en anglais "humalis" vers "accueil" avec style "brand"
        menu repliable avec style "nav-links" :
            lien "Accueil" en anglais "Home" vers "accueil"
            lien "Documentation" en anglais "Documentation" vers "documentation"
            lien "Exemples" en anglais "Examples" vers "exemples"
            lien "Bac à sable" en anglais "Playground" vers "bac_a_sable"
            lien "Installer" en anglais "Install" vers "installer"
        ligne avec style "utility" :
            # « FR / EN » : la langue choisie en gras, l'autre se choisit d'un clic.
            ligne avec style "language" :
                si langue est anglais :
                    bouton "FR" en anglais "FR" avec nom "vers-francais" et style "lang-choix"
                    texte "/" en anglais "/" avec style "lang-sep"
                    texte "EN" en anglais "EN" avec style "lang-actif"
                    quand l'utilisateur clique sur "vers-francais" :
                        changer langue par francais
                sinon :
                    texte "FR" en anglais "FR" avec style "lang-actif"
                    texte "/" en anglais "/" avec style "lang-sep"
                    bouton "EN" en anglais "EN" avec nom "vers-anglais" et style "lang-choix"
                    quand l'utilisateur clique sur "vers-anglais" :
                        changer langue par anglais
            # Le thème : une icône seule, la lune en sombre, le soleil en clair.
            si theme est sombre :
                bouton "Passer au thème clair" en anglais "Switch to light theme" avec icone "lune" et nom "theme-sombre" et style "icon-button"
                quand l'utilisateur clique sur "theme-sombre" :
                    basculer theme
            sinon :
                bouton "Passer au thème sombre" en anglais "Switch to dark theme" avec icone "soleil" et nom "theme-clair" et style "icon-button"
                quand l'utilisateur clique sur "theme-clair" :
                    basculer theme
            lien "GitHub ↗" en anglais "GitHub ↗" vers "https://github.com/emch04/humalis" avec nouvel onglet et style "github-link"

pied avec style "site-footer" :
    ligne avec style "footer-grid" :
        colonne avec style "footer-marque" :
            lien "humalis" en anglais "humalis" vers "accueil" avec style "brand"
            texte "Le langage de programmation qui s’écrit en français, de la page web au serveur." en anglais "The programming language you write in French, from the web page to the server."
        colonne avec style "footer-col" :
            texte "Découvrir" en anglais "Discover" avec style "footer-titre"
            lien "Accueil" en anglais "Home" vers "accueil"
            lien "Exemples" en anglais "Examples" vers "exemples"
            lien "Bac à sable" en anglais "Playground" vers "bac_a_sable"
        colonne avec style "footer-col" :
            texte "Documentation" en anglais "Documentation" avec style "footer-titre"
            lien "Installer" en anglais "Install" vers "installer"
            lien "Sommaire" en anglais "Contents" vers "documentation"
            lien "Premiers pas" en anglais "First steps" vers "documentation_1"
            lien "Les commandes" en anglais "Commands" vers "documentation_32"
            lien "Nouveautés" en anglais "What’s new" vers "nouveautes"
        colonne avec style "footer-col" :
            texte "Projet" en anglais "Project" avec style "footer-titre"
            lien "GitHub" sans traduction vers "https://github.com/emch04/humalis" avec nouvel onglet
            lien "Signaler un problème" en anglais "Report an issue" vers "https://github.com/emch04/humalis/issues" avec nouvel onglet
            lien "Paquet npm" en anglais "npm package" vers "https://www.npmjs.com/package/humalis" avec nouvel onglet
            lien "Licence Humalis" en anglais "Humalis License" vers "https://github.com/emch04/humalis/blob/main/LICENSE" avec nouvel onglet
    ligne avec style "footer-bas" :
        texte "© 2026 Les auteurs de Humalis. Tous droits réservés." en anglais "© 2026 The Humalis authors. All rights reserved."
        ligne avec style "footer-legal" :
            lien "Mentions légales" en anglais "Legal notice" vers "mentions_legales"
            lien "Confidentialité" en anglais "Privacy" vers "confidentialite"
        texte "Ce site est écrit en Humalis." en anglais "This site is written in Humalis."

page "accueil" :
    apercu :
        description "Écris ton application comme une phrase avec Humalis : découvre le langage, ses cinq cibles et ses possibilités."
    bloc avec ancre "accueil" et style "hero" :
        ligne avec style "hero-grid" :
            colonne avec style "hero-copy" :
                texte "Le code prend la parole" en anglais "Code finds its voice" avec style "eyebrow"
                titre "Écris ton application comme une {accent "phrase."}" en anglais "Write your app like a {accent "sentence."}" avec style "hero-title"
                texte "Un seul langage, en français, pour le web, le mobile, le bureau et le serveur. Tu écris une fois. Humalis donne vie à ton idée partout." en anglais "One language, in French, for web, mobile, desktop and server. Write once. Humalis brings your idea to life everywhere." avec style "hero-intro"
                ligne avec style "hero-actions" :
                    lien "Essayer maintenant →" en anglais "Try it now →" vers "bac_a_sable" avec style "button button-primary"
                    lien "Lire la documentation" en anglais "Read the docs" vers "documentation" avec style "button button-secondary"
                ligne avec ancre "installer" et style "install-command" :
                    texte "npm install -g humalis" en anglais "npm install -g humalis" avec style "install-code"
                    bouton "Copier" en anglais "Copy" avec nom "copier" et style "copy-button"
                quand l'utilisateur clique sur "copier" :
                    copier "npm install -g humalis" avec message "Commande copiée" en anglais "Command copied"
            # La démonstration : le code se tape à gauche, l'aperçu se construit à droite, en cascade.
            bloc avec style "demo-shell" :
                ligne avec style "demo-grid" :
                    colonne avec style "editor-pane" :
                        ligne avec style "pane-top" :
                            texte "boutique.humalis" sans traduction
                            texte "● en direct" en anglais "● live"
                        code humalis avec animation frappe :
                            page "boutique" :
                                titre "Nos produits"
                                variable produits = ["Livre", "Stylo", "Cahier"]
                                pour chaque nom dans produits :
                                    texte nom
                                bouton "Commander"
                                quand l'utilisateur clique sur "Commander" :
                                    afficher "Merci pour ta commande !"
                    colonne avec style "preview-pane" :
                        ligne avec style "pane-top" :
                            texte "Aperçu web" en anglais "Web preview"
                        colonne avec style "preview-body" et animation montee au defilement et en cascade :
                            texte "Ma boutique" en anglais "My shop" avec style "preview-caption"
                            texte "Nos produits" en anglais "Our products" avec style "preview-title"
                            texte "Livre" en anglais "Book" avec style "preview-item show"
                            texte "Stylo" en anglais "Pen" avec style "preview-item show"
                            texte "Cahier" en anglais "Notebook" avec style "preview-item show"
                            bouton "Commander" en anglais "Order" avec style "preview-order show"
                        quand l'utilisateur clique sur "Commander" :
                            afficher reussite "Merci pour ta commande !" en anglais "Thank you for your order!"
    bloc avec style "section target-section" :
        colonne avec style "section-heading" :
            soustitre "Un fichier, cinq cibles." en anglais "One file, five targets."
            texte "Ton idée commence dans un fichier .humalis. Le compilateur prépare le reste, sans te faire réécrire chaque application." en anglais "Your idea starts in a .humalis file. The compiler prepares the rest, without making you rewrite every app."
        texte "application.humalis" en anglais "application.humalis" avec style "source-file"
        grille avec colonnes 5 et style "target-diagram" et animation montee au defilement et en cascade :
            bloc avec style "target-card" :
                icone "globe" avec decoratif
                soustitre "Web" en anglais "Web" avec niveau 3
                texte "Application React" en anglais "React app"
            bloc avec style "target-card" :
                icone "mobile" avec decoratif
                soustitre "Mobile" en anglais "Mobile" avec niveau 3
                texte "Application Expo" en anglais "Expo app"
            bloc avec style "target-card" :
                icone "ordinateur" avec decoratif
                soustitre "Bureau" en anglais "Desktop" avec niveau 3
                texte "Application Electron" en anglais "Electron app"
            bloc avec style "target-card" :
                icone "document" avec decoratif
                soustitre "Statique" en anglais "Static" avec niveau 3
                texte "Site prêt à publier" en anglais "Ready-to-publish site"
            bloc avec style "target-card" :
                icone "bouclier" avec decoratif
                soustitre "Serveur" en anglais "Server" avec niveau 3
                texte "Serveur Node" en anglais "Node server"
    bloc avec style "section features" :
        colonne avec style "section-heading" :
            soustitre "De l’idée au concret." en anglais "From idea to reality."
            texte "Des outils pour construire une vraie application, tout en gardant des mots que tu comprends." en anglais "Tools to build a real app, using words you understand."
        grille avec colonnes 3 et style "feature-grid" et animation montee au defilement et en cascade :
            bloc avec style "feature-card" :
                icone "document" avec decoratif
                soustitre "Pages et formulaires" en anglais "Pages and forms" avec niveau 3
                texte "Crée des écrans et recueille les réponses de tes visiteurs." en anglais "Build screens and collect responses from your visitors."
            bloc avec style "feature-card" :
                icone "dossier" avec decoratif
                soustitre "Données et serveur" en anglais "Data and server" avec niveau 3
                texte "Relie ton interface à la logique qui fait fonctionner ton projet." en anglais "Connect your interface to the logic behind your project."
            bloc avec style "feature-card" :
                icone "globe" avec decoratif
                soustitre "Plusieurs langues" en anglais "Multiple languages" avec niveau 3
                texte "Adapte les textes de ton application à ceux qui l’utilisent." en anglais "Adapt your app's text to the people using it."
            bloc avec style "feature-card" :
                icone "carte" avec decoratif
                soustitre "Graphiques et cartes" en anglais "Charts and maps" avec niveau 3
                texte "Rends tes informations faciles à lire et à explorer." en anglais "Make your information easy to read and explore."
            bloc avec style "feature-card" :
                icone "oeil" avec decoratif
                soustitre "Accessibilité vérifiée" en anglais "Accessibility checks" avec niveau 3
                texte "Des repères pour créer des interfaces que chacun peut utiliser." en anglais "Guidance for building interfaces everyone can use."
            bloc avec style "feature-card" :
                icone "alerte" avec decoratif
                soustitre "Erreurs en français" en anglais "Errors in French" avec niveau 3
                texte "Comprends ce qui bloque et trouve rapidement comment avancer." en anglais "Understand what's wrong and quickly find a way forward."
    bloc avec style "section errors-layout" :
        colonne avec style "section-heading" :
            soustitre "Des erreurs qui t’aident." en anglais "Errors that help you."
            texte "Quand une lettre dérape, le message te montre où regarder et te propose une piste claire." en anglais "When a letter goes astray, the message shows where to look and gives you a clear hint."
        colonne avec style "terminal" :
            texte "Terminal · compilation" en anglais "Terminal · compilation" avec style "terminal-top"
            texte "$ humalis compile boutique.humalis" en anglais "$ humalis compile boutique.humalis" avec style "terminal-command"
            texte "Erreur, ligne 3 : la variable « totl » n'est pas déclarée. Peut-être « total » ?" en anglais "Error, line 3: variable ‘totl’ is not declared. Did you mean ‘total’?" avec style "terminal-error"
            texte "↳ Vérifie l’orthographe du nom de la variable." en anglais "↳ Check the spelling of the variable name." avec style "terminal-hint"
    bloc avec style "section more-pages" :
        colonne avec style "section-heading" :
            soustitre "Un site pour aller plus loin." en anglais "A site to go further."
            texte "Une vue sur les pages qui accompagneront tes premières lignes de code." en anglais "A look at the pages that will guide your first lines of code."
        grille avec colonnes 3 et style "page-grid" :
            bloc avec ancre "documentation" et style "page-card" :
                bloc avec style "page-mini mini-learn" :
                    texte "Tes premiers pas" en anglais "Your first steps" avec style "mini-title"
                    texte "page bonjour :" en anglais "page hello :" avec style "mini-code"
                    texte "texte Bienvenue !" en anglais "texte Welcome!" avec style "mini-code"
                soustitre "Documentation" en anglais "Documentation" avec niveau 3
                texte "Un parcours clair, du premier mot à ta première application." en anglais "A clear path from your first word to your first app."
                lien "Lire la documentation ↗" en anglais "Read the docs ↗" vers "documentation"
            bloc avec ancre "exemples" et style "page-card" :
                bloc avec style "page-mini mini-examples" :
                    texte "Des idées à explorer" en anglais "Ideas to explore" avec style "mini-title"
                    grille avec colonnes 2 et style "mini-gallery" :
                        bloc avec style "mini-tile" :
                            texte "A" en anglais "A"
                        bloc avec style "mini-tile" :
                            texte "B" en anglais "B"
                        bloc avec style "mini-tile" :
                            texte "C" en anglais "C"
                        bloc avec style "mini-tile" :
                            texte "D" en anglais "D"
                soustitre "Exemples" en anglais "Examples" avec niveau 3
                texte "Des projets concrets pour découvrir ce que Humalis peut faire." en anglais "Real projects to discover what Humalis can do."
                lien "Voir le concept ↗" en anglais "Explore the concept ↗" vers "exemples"
            bloc avec ancre "bac-a-sable" et style "page-card" :
                bloc avec style "page-mini mini-sandbox" :
                    texte "page carte :" en anglais "page card :" avec style "mini-code"
                    texte "titre Bonjour" en anglais "titre Hello" avec style "mini-code"
                    texte "bouton Entrer" en anglais "bouton Enter" avec style "mini-code"
                soustitre "Bac à sable" en anglais "Playground" avec niveau 3
                texte "Un éditeur et son aperçu pour essayer une idée tout de suite." en anglais "An editor and preview to try an idea right away."
                lien "Voir le concept ↗" en anglais "Explore the concept ↗" vers "bac_a_sable"
    bloc avec style "final-call" :
        colonne avec style "call-panel" :
            soustitre "Ta première application en cinq minutes." en anglais "Your first app in five minutes."
            texte "Une phrase suffit pour commencer. La suite t’appartient." en anglais "One sentence is enough to start. The rest is yours."
            lien "Essayer maintenant →" en anglais "Try it now →" vers "bac_a_sable" avec style "button button-primary"

page "bac_a_sable" a l'adresse "/bac-a-sable" avec filtre exemple :
    apercu :
        titre "Bac à sable" en anglais "Playground"
        description "Essaie Humalis dans ton navigateur : écris du code en français et vois le site apparaître au fil de la frappe." en anglais "Try Humalis in your browser: write code in French and watch the site appear as you type."
    ligne avec style "bac-entete" et animation montee :
        colonne avec style "bac-entete-texte" :
            texte "Rien à installer" en anglais "Nothing to install" avec style "eyebrow"
            titre "Bac à {accent "sable."}" en anglais "{accent "Playground."}" avec style "install-titre"
            texte "Écris du Humalis à gauche : le site apparaît à droite, au fil de la frappe. Choisis un exemple pour partir de quelque chose, ou efface tout et commence par une phrase." en anglais "Write Humalis on the left: the site appears on the right as you type. Pick an example to start from something, or clear everything and begin with one sentence." avec style "hero-intro"
        colonne avec style "bac-astuces" et animation montee au defilement et en cascade :
            texte "Tab ajoute quatre espaces : c’est l’indentation de Humalis." en anglais "Tab adds four spaces: that is Humalis indentation." avec style "bac-astuce"
            texte "Les erreurs s’affichent sous l’éditeur, en français, avec la ligne." en anglais "Errors show below the editor, with the line number." avec style "bac-astuce"
            texte "Tout reste dans ton navigateur : ton code n’est envoyé nulle part." en anglais "Everything stays in your browser: your code is sent nowhere." avec style "bac-astuce"
    EditeurHumalis avec exemple exemple
    bloc avec style "install-section" :
        colonne avec style "section-heading" :
            soustitre "Et maintenant ?" en anglais "What next?"
        grille avec colonnes 3 et style "bac-suite" et animation montee au defilement et en cascade :
            bloc avec style "install-carte" et effet leve :
                soustitre "Apprendre le langage" en anglais "Learn the language" avec niveau 3
                texte "Chaque construction de Humalis, avec un exemple vérifié." en anglais "Every Humalis construct, with a checked example."
                lien "Lire la documentation →" en anglais "Read the docs →" vers "documentation" avec style "exemple-lien"
            bloc avec style "install-carte" et effet leve :
                soustitre "Partir d’un exemple" en anglais "Start from an example" avec niveau 3
                texte "Six applications complètes à ouvrir et à modifier." en anglais "Six complete apps to open and change."
                lien "Voir les exemples →" en anglais "See the examples →" vers "exemples" avec style "exemple-lien"
            bloc avec style "install-carte" et effet leve :
                soustitre "Travailler sur ta machine" en anglais "Work on your machine" avec niveau 3
                texte "Trois commandes pour créer ton projet et le voir vivre." en anglais "Three commands to create your project and see it live."
                lien "Installer Humalis →" en anglais "Install Humalis →" vers "installer" avec style "exemple-lien"

page "exemples" a l'adresse "/exemples" :
    apercu :
        titre "Exemples" en anglais "Examples"
        description "Des applications écrites en Humalis : boutique, formulaire, restaurant, liste de tâches. Ouvre chacune dans le bac à sable." en anglais "Apps written in Humalis: shop, form, restaurant, to-do list. Open each one in the playground."
    ligne avec style "install-hero" :
        colonne avec style "install-hero-texte" et animation montee :
            texte "Six applications à ouvrir" en anglais "Six apps to open" avec style "eyebrow"
            titre "Des {accent "exemples"} qui tiennent en quelques lignes." en anglais "{accent "Examples"} that fit in a few lines." avec style "install-titre"
            texte "Chaque exemple est une vraie application, écrite en Humalis. Ouvre-le dans le bac à sable, change une phrase, et regarde le résultat changer avec toi." en anglais "Each example is a real app, written in Humalis. Open it in the playground, change one sentence, and watch the result change with you." avec style "hero-intro"
            ligne avec style "install-pastilles" :
                texte "100 % Humalis" sans traduction avec style "pastille"
                texte "Modifiables en direct" en anglais "Editable live" avec style "pastille"
                texte "Moins de 30 lignes" en anglais "Under 30 lines" avec style "pastille"
        bloc avec style "install-terminal" et animation agrandissement :
            ligne avec style "pane-top" :
                texte "compteur.humalis" sans traduction
            code humalis avec animation frappe :
                page "compteur" :
                    variable clics = 0
                    titre "Compteur"
                    texte "Tu as cliqué {clics} fois"
                    bouton "Cliquer"
                    quand l'utilisateur clique sur "Cliquer" :
                        changer clics par clics + 1
    bloc avec style "install-section" :
        colonne avec style "section-heading" :
            soustitre "Choisis, ouvre, modifie." en anglais "Pick, open, change."
        grille avec colonnes 3 et style "exemples-grille" et animation montee au defilement et en cascade :
            bloc avec style "exemple-carte ex-boutique" et effet leve :
                bloc avec style "exemple-vignette" :
                    texte "boutique.humalis" sans traduction avec style "vignette-fichier"
                    texte "pour chaque nom dans produits :" sans traduction avec style "vignette-code"
                colonne avec style "exemple-corps" :
                    soustitre "Boutique" en anglais "Shop" avec niveau 3
                    texte "Une liste de produits et un bouton qui répond." en anglais "A product list and a button that answers."
                    ligne avec style "exemple-tags" :
                    texte "Listes" en anglais "Lists" avec style "tag"
                    texte "Boucle" en anglais "Loop" avec style "tag"
                    lien "Ouvrir dans le bac à sable →" en anglais "Open in the playground →" vers "bac_a_sable" avec exemple "boutique" et style "exemple-lien"
            bloc avec style "exemple-carte ex-compteur" et effet leve :
                bloc avec style "exemple-vignette" :
                    texte "compteur.humalis" sans traduction avec style "vignette-fichier"
                    texte "changer clics par clics + 1" sans traduction avec style "vignette-code"
                colonne avec style "exemple-corps" :
                    soustitre "Compteur" en anglais "Counter" avec niveau 3
                    texte "Une variable qui change à chaque clic." en anglais "A variable that changes on every click."
                    ligne avec style "exemple-tags" :
                    texte "Variables" en anglais "Variables" avec style "tag"
                    texte "Clic" en anglais "Click" avec style "tag"
                    lien "Ouvrir dans le bac à sable →" en anglais "Open in the playground →" vers "bac_a_sable" avec exemple "compteur" et style "exemple-lien"
            bloc avec style "exemple-carte ex-formulaire" et effet leve :
                bloc avec style "exemple-vignette" :
                    texte "formulaire.humalis" sans traduction avec style "vignette-fichier"
                    texte "champ email \"Email\" avec obligatoire" sans traduction avec style "vignette-code"
                colonne avec style "exemple-corps" :
                    soustitre "Formulaire" en anglais "Form" avec niveau 3
                    texte "Des champs obligatoires, vérifiés avant l’envoi." en anglais "Required fields, checked before sending."
                    ligne avec style "exemple-tags" :
                    texte "Formulaire" en anglais "Form" avec style "tag"
                    texte "Validation" en anglais "Validation" avec style "tag"
                    lien "Ouvrir dans le bac à sable →" en anglais "Open in the playground →" vers "bac_a_sable" avec exemple "formulaire" et style "exemple-lien"
            bloc avec style "exemple-carte ex-restaurant" et effet leve :
                bloc avec style "exemple-vignette" :
                    texte "restaurant.humalis" sans traduction avec style "vignette-fichier"
                    texte "couleur marque \"#9a3412\"" sans traduction avec style "vignette-code"
                colonne avec style "exemple-corps" :
                    soustitre "Restaurant" en anglais "Restaurant" avec niveau 3
                    texte "Un thème à ses couleurs, une grille de plats." en anglais "A theme in its own colours, a grid of dishes."
                    ligne avec style "exemple-tags" :
                    texte "Thème" en anglais "Theme" avec style "tag"
                    texte "Grille" en anglais "Grid" avec style "tag"
                    texte "CSS" en anglais "CSS" avec style "tag"
                    lien "Ouvrir dans le bac à sable →" en anglais "Open in the playground →" vers "bac_a_sable" avec exemple "restaurant" et style "exemple-lien"
