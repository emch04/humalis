# Généré par scripts/antiseche-site.mjs depuis docs/antiseche.md : modifier la source, pas ce fichier.

page "antiseche" a l'adresse "/antiseche" :
    apercu :
        titre "Antisèche Humalis" en anglais "Humalis cheat sheet"
        description "Toutes les formules exactes de Humalis sur une page, et les tournures à éviter. Chaque formule est compilée à chaque version." en anglais "Every exact Humalis phrase on one page, and the wordings to avoid. Each one is compiled for every release."
    bloc avec style "aide" :
        titre "Antisèche" en anglais "Cheat sheet"
        texte "Les formules exactes, à copier. Chaque exemple est compilé à chaque version de Humalis." en anglais "The exact phrases, ready to copy. Every example is compiled for each Humalis release."
        ligne avec style "aide-sommaire" :
            lien "Écrire" en anglais "Writing" vers "#ecrire"
            lien "Les pages" en anglais "Pages" vers "#pages"
            lien "Les éléments" en anglais "Elements" vers "#elements"
            lien "Les formulaires" en anglais "Forms" vers "#formulaires"
            lien "La mise en page et les styles" en anglais "Layout and styles" vers "#mise-en-page"
            lien "Les variables et les calculs" en anglais "Variables and calculations" vers "#variables"
            lien "Les conditions" en anglais "Conditions" vers "#conditions"
            lien "Les listes et les boucles" en anglais "Lists and loops" vers "#listes"
            lien "Les événements" en anglais "Events" vers "#evenements"
            lien "Les actions et les messages" en anglais "Actions and messages" vers "#actions"
            lien "Le serveur" en anglais "The server" vers "#serveur"
            lien "Relier les pages au serveur" en anglais "Connecting pages to the server" vers "#relier"
            lien "Le site, les langues et le reste" en anglais "The site, languages and the rest" vers "#site"
            lien "Les commandes" en anglais "Commands" vers "#commandes"
            lien "Les pièges" en anglais "Common traps" vers "#pieges"
            lien "Médias" en anglais "Media" vers "#medias"
