# Les nouveautés : la frise des versions, et la colonne qui reste en vue.

page "nouveautes" a l'adresse "/nouveautes" sans pied :
    apercu :
        titre "Nouveautés" en anglais "What’s new"
        description "Ce qui change dans Humalis, version après version : nouvelles constructions du langage, corrections et améliorations." en anglais "What changes in Humalis, release after release: new language constructs, fixes and improvements."
    # La frise défile seule à gauche ; la colonne de droite ne bouge pas.
    ligne avec style "nouveautes-corps" et hauteur ecran :
        colonne avec style "nouveautes-fil" et defilement interne :
            colonne avec style "install-hero-texte" et animation montee :
                texte "Journal des versions" en anglais "Release notes" avec style "eyebrow"
                titre "Les {accent "nouveautés."}" en anglais "What’s {accent "new."}" avec style "install-titre"
                texte "Ce qui change dans le langage et son compilateur, de la plus récente version à la première. Pour mettre à jour : `npm install -g humalis`." en anglais "What changes in the language and its compiler, from the latest release to the first. To update: `npm install -g humalis`." avec style "hero-intro"
            colonne avec style "frise" et animation montee au defilement et en cascade :
                bloc avec style "version version-recente" :
                    ligne avec style "version-tete" :
                        texte "1.8.0" sans traduction avec style "version-numero"
                        texte "Dernière version" en anglais "Latest" avec style "pastille pastille-vive"
                        texte "8 novembre 2026" en anglais "November 8, 2026" avec style "version-date"
                    soustitre "De la 3D dans une page Humalis" en anglais "3D in a Humalis page"
                    liste :
                        texte "Un composant React peut être écrit en `.jsx` aussi bien qu’en `.tsx`." en anglais "A React component can be written in `.jsx` as well as `.tsx`."
                        texte "Les paquets qu’un composant importe (`three`, `gsap`, `@react-three/…`, `lenis`) sont ajoutés tout seuls au projet produit." en anglais "The packages a component imports (`three`, `gsap`, `@react-three/…`, `lenis`) are added to the generated project automatically."
                        texte "Un composant 3D est chargé à part : le texte de la page s’affiche sans l’attendre." en anglais "A 3D component is loaded separately: the page text appears without waiting for it."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.7.4" sans traduction avec style "version-numero"
                        texte "4 novembre 2026" en anglais "November 4, 2026" avec style "version-date"
                    soustitre "Moins de fausses alertes" en anglais "Fewer false alarms"
                    liste :
                        texte "Une page `reservee a admin`, et un composant placé seulement dans des pages réservées, ne préviennent plus qu’un visiteur serait refusé." en anglais "A `reservee a admin` page, and a component placed only in reserved pages, no longer warn that a visitor would be refused."
                        texte "`erreurs pendant 2 secondes` dans le bloc `site :` est un choix : plus d’avertissement sur cette ligne." en anglais "`erreurs pendant 2 secondes` in the `site :` block is a choice: no more warning on that line."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.7.3" sans traduction avec style "version-numero"
                        texte "4 novembre 2026" en anglais "November 4, 2026" avec style "version-date"
                    soustitre "Modifier ce que le serveur décide" en anglais "Modifying what the server decides"
                    liste :
                        texte "`modifier` accepte de nouveau un champ `au depart` ou `calcule` : seule la création le refuse." en anglais "`modifier` accepts an `au depart` or `calcule` field again: only creation refuses it."
                        texte "Une variable `memorisee` est écrite tout de suite : un `rediriger` juste après ne la perd plus." en anglais "A `memorisee` variable is written at once: a `rediriger` right after no longer loses it."
                        texte "`non vide` refuse une liste ou un texte vide, et `rediriger vers \"https://…\"` marche aussi sur le site statique." en anglais "`non vide` refuses an empty list or text, and `rediriger vers \"https://…\"` also works on the static target."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.7.2" sans traduction avec style "version-numero"
                        texte "4 novembre 2026" en anglais "November 4, 2026" avec style "version-date"
                    soustitre "Ce que le serveur décide" en anglais "What the server decides"
                    liste :
                        texte "`au depart`, `calcule`, `au plus` et `du site` : une requête publique ne choisit plus un statut, un total ou une adresse d’image." en anglais "`au depart`, `calcule`, `au plus` and `du site`: a public request can no longer choose a status, a total or an image address."
                        texte "`par identifiant` ouvre une fiche à la fois, sans la liste ; `creer … dans …` crée une fiche liée côté serveur." en anglais "`par identifiant` opens one record at a time, without the list; `creer … dans …` creates a linked record on the server."
                        texte "`HUMALIS_ECOUTE` choisit l’adresse d’écoute, et le serveur ne dit plus qu’il tourne sous Express." en anglais "`HUMALIS_ECOUTE` sets the listening address, and the server no longer says it runs on Express."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.7.1" sans traduction avec style "version-numero"
                        texte "4 novembre 2026" en anglais "November 4, 2026" avec style "version-date"
                    soustitre "La liste des comptes se construit" en anglais "The account list builds"
                    liste :
                        texte "Une page qui lit les `comptes` passe maintenant `npm run build` : leur type manquait au code produit." en anglais "A page that reads `comptes` now passes `npm run build`: their type was missing from the generated code."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.7.0" sans traduction avec style "version-numero"
                        texte "4 novembre 2026" en anglais "November 4, 2026" avec style "version-date"
                    soustitre "Inviter son équipe, envoyer des e-mails" en anglais "Invite your team, send emails"
                    liste :
                        texte "`inviter champ \"Adresse\" comme admin` envoie un lien à usage unique ; la personne choisit son mot de passe ou entre avec Google." en anglais "`inviter champ \"Adresse\" comme admin` sends a single-use link; the person chooses a password or comes in with Google."
                        texte "Mot de passe oublié, liste des comptes et retrait d’un membre, dans la grammaire des routes." en anglais "Forgotten password, account list and member removal, in the same grammar as routes."
                        texte "`quand message est cree :` et `envoyer email aux admins avec sujet … et texte …` : le serveur écrit quand une fiche arrive." en anglais "`quand message est cree :` and `envoyer email aux admins avec sujet … et texte …`: the server writes when a record arrives."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.6.0" sans traduction avec style "version-numero"
                        texte "4 novembre 2026" en anglais "November 4, 2026" avec style "version-date"
                    soustitre "Des erreurs réglables et toujours en français" en anglais "Adjustable errors, always in French"
                    liste :
                        texte "`erreurs pendant 5 secondes` dans le bloc `site :` règle la durée de toutes les erreurs du site, celles que Humalis affiche de lui-même comprises." en anglais "`erreurs pendant 5 secondes` in the `site :` block sets how long all the site’s errors stay, including the ones Humalis shows by itself."
                        texte "Une panne du réseau affiche la phrase française de Humalis, et non plus le texte anglais du navigateur." en anglais "A network failure shows Humalis’s own sentence instead of the browser’s raw English text."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.5.2" sans traduction avec style "version-numero"
                        texte "1er novembre 2026" en anglais "November 1, 2026" avec style "version-date"
                    soustitre "Des connexions et des exports plus sûrs" en anglais "Safer sign-ins and exports"
                    liste :
                        texte "Le pare-feu ne bloque plus un mot de passe qui contient « -- » : sans ce correctif, son propriétaire ne pouvait pas se connecter." en anglais "The firewall no longer blocks a password containing “--”: without this fix, its owner could not sign in."
                        texte "Une note ou une adresse peut contenir « -- » ou « /* » ; les vraies injections et les scripts restent bloqués." en anglais "A note or an address can contain “--” or “/*”; real injections and scripts stay blocked."
                        texte "Une `constante` du haut d’un fichier vaut aussi pour les autres fichiers du projet." en anglais "A `constante` at the top of a file now applies to the project’s other files too."
                        texte "Un numéro de téléphone reste lisible dans un CSV, et les images d’un dossier `images/` ne sortent plus sous `/images/images/`." en anglais "A phone number stays readable in a CSV, and images in an `images/` folder no longer end up under `/images/images/`."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.5.1" sans traduction avec style "version-numero"
                        texte "1er novembre 2026" en anglais "November 1, 2026" avec style "version-date"
                    soustitre "Un calcul partagé dans tout le projet" en anglais "A shared calculation across the project"
                    liste :
                        texte "Un `calcul` écrit en haut d’un fichier arrive aussi dans les pages des autres fichiers du projet." en anglais "A `calcul` at the top of a file now reaches the pages of the project’s other files too."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.5.0" sans traduction avec style "version-numero"
                        texte "1er novembre 2026" en anglais "November 1, 2026" avec style "version-date"
                    soustitre "Plus de phrases pour les vraies boutiques" en anglais "More phrases for real shops"
                    liste :
                        texte "`si non actif :` retourne une condition, et `dont` accepte plusieurs conditions avec `et` et `ou`." en anglais "`si non actif :` reverses a condition, and `dont` takes several conditions with `et` and `ou`."
                        texte "`trier (produits dont visible est vrai) par prix` trie une liste filtrée ; un texte accepte un calcul entre accolades." en anglais "`trier (products dont visible est vrai) par price` sorts a filtered list; a text accepts a calculation."
                        texte "Un `calcul` en haut du fichier vaut pour toutes les pages, et `selon` s’écrit aussi dans une page." en anglais "A `calcul` at the top of the file applies to every page, and `selon` also works in a page."
                        texte "`telecharger commandes en csv` enregistre une liste pour Excel, et un formulaire ou un fil d’Ariane prennent `avec style`." en anglais "`telecharger orders en csv` saves a list for Excel, and a form or a breadcrumb take `avec style`."
                        texte "Connexion avec Google, changement de mot de passe, type `image`, bon de commande en PDF et fidélité par tampons." en anglais "Sign-in with Google, password change, `image` type, PDF order slip and stamp loyalty."
                        texte "Les dates restent en français partout, le pare-feu accepte le « # » dans une adresse, et le dossier de sortie retire les fichiers qui ne servent plus." en anglais "Dates stay in French everywhere, the firewall accepts “#” in an address, and the output folder removes files no longer used."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.4.0" sans traduction avec style "version-numero"
                        texte "31 octobre 2026" en anglais "October 31, 2026" avec style "version-date"
                    soustitre "Écrire comme on parle, des sites plus légers" en anglais "Write as you speak, lighter sites"
                    liste :
                        texte "Le code d’une phrase s’écrit entre accents graves : {code "Écris `titre` pour commencer"}, guillemets et accolades compris." en anglais "Code in a sentence goes between backticks: {code "Write `titre` to start"}, quotes and braces included."
                        texte "Les langues tiennent sur une ligne : `langues : francais, anglais`, avec des messages clairs pour une virgule oubliée." en anglais "Languages fit on one line: `langues : francais, anglais`, with clear messages for a missing comma."
                        texte "Chaque page web est dans son propre fichier, chargé à sa première visite : le site public passe de 947 à 238 Ko au départ." en anglais "Each web page has its own file, loaded on its first visit: the public site goes from 947 to 238 KB at start."
                        texte "Sous `entete avec fixe`, la page ne glisse plus de côté quand un décor dépasse." en anglais "Under `entete avec fixe`, the page no longer slides sideways when a decoration overflows."
                        texte "Le guide liste les petits mots qui ne peuvent pas servir de nom ; la couleur des blocs de code suit la fin réelle d’un texte." en anglais "The guide lists the small words that cannot be names; code block colours follow the real end of a text."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.3.1" sans traduction avec style "version-numero"
                        texte "31 octobre 2026" en anglais "October 31, 2026" avec style "version-date"
                    soustitre "La version en une commande" en anglais "The version in one command"
                    liste :
                        texte "`humalis --version` affiche la version installée, et `humalis --aide` le mode d’emploi." en anglais "`humalis --version` shows the installed version, and `humalis --help` the usage."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.3.0" sans traduction avec style "version-numero"
                        texte "31 octobre 2026" en anglais "October 31, 2026" avec style "version-date"
                    soustitre "Des pages qui tiennent dans l’écran" en anglais "Pages that fit the screen"
                    liste :
                        texte "`entete avec fixe :` garde l’en-tête immobile : seule la zone en dessous défile." en anglais "`entete avec fixe :` keeps the header still: only the area below it scrolls."
                        texte "`hauteur ecran` fait remplir l’écran à un bloc, sous l’en-tête ; `defilement interne` donne à un bloc son propre défilement, comme un sommaire ou une frise." en anglais "`hauteur ecran` makes a block fill the screen below the header; `defilement interne` gives a block its own scrolling, like a table of contents or a timeline."
                        texte "`humalis verifier` signale un style écrit dans `avec style` mais absent du CSS, avec le nom le plus proche, et une règle CSS qui écrase une classe Humalis avec `!important`." en anglais "`humalis verifier` reports a style used in `avec style` but missing from the CSS, with the closest name, and a CSS rule that overrides a Humalis class with `!important`."
                        texte "Avec `humalis developper`, chaque élément de la page porte son fichier et sa ligne Humalis ; Alt + survol affiche ce repère près du curseur." en anglais "With `humalis developper`, every element on the page carries its Humalis file and line; Alt + hover shows it next to the cursor."
                        texte "Correction : les pages préparées à l’avance sont écrites dans la langue de base du site, quelle que soit la langue de l’outil qui les prépare." en anglais "Fix: prerendered pages are written in the site’s base language, whatever the language of the tool that prepares them."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.2.0" sans traduction avec style "version-numero"
                        texte "30 octobre 2026" en anglais "October 30, 2026" avec style "version-date"
                    soustitre "Des menus et des titres mieux rangés" en anglais "Better menus and headings"
                    liste :
                        texte "`menu vertical :` range les liens en colonne, sans jamais ouvrir une deuxième colonne : un sommaire de hauteur limitée défile." en anglais "`menu vertical :` stacks the links in a column and never starts a second one: a table of contents with a limited height scrolls."
                        texte "Le bouton d’un `menu repliable` devient une icône burger, en croix quand le menu est ouvert ; un toucher à côté ou la touche Échap referment le menu." en anglais "The button of a `menu repliable` becomes a burger icon, a cross while the menu is open; tapping outside or pressing Escape closes it."
                        texte "Dans une `section`, le premier sous-titre la titre et les autres descendent d’un niveau, même rangés dans des cartes." en anglais "In a `section`, the first subtitle titles it and the others go down one level, even inside cards."
                        texte "Un titre dans chaque branche de `si langue est …` ne compte qu’une fois." en anglais "A title in each branch of `si langue est …` counts only once."
                        texte "Corrections : le style du menu sur le téléphone, et la remise en haut de la page quand c’est la zone sous l’en-tête qui défile." en anglais "Fixes: the menu style on phones, and scrolling back to the top when the area under the header is what scrolls."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.1.0" sans traduction avec style "version-numero"
                        texte "30 octobre 2026" en anglais "October 30, 2026" avec style "version-date"
                    soustitre "Écrire une documentation, animer le code" en anglais "Write documentation, animate code"
                    liste :
                        texte "Les listes (`liste :`, `liste numerotee :`), les tableaux (`tableau`, `colonnes`, `rangee`), le code dans une phrase (`{code "…"}`) et les blocs de code colorés avec un bouton Copier." en anglais "Lists (`liste :`, `liste numerotee :`), tables (`tableau`, `colonnes`, `rangee`), code in a sentence (`{code "…"}`) and coloured code blocks with a Copy button."
                        texte "`avec animation frappe` : un bloc de code s’écrit lettre par lettre, au chargement ou quand il arrive à l’écran." en anglais "`avec animation frappe`: a code block types itself letter by letter, on load or when it scrolls into view."
                        texte "`changer x par champ "…"` et `ajouter champ "…" à liste` : la valeur d’un champ dans une variable ou une liste." en anglais "`changer x par champ "…"` and `ajouter champ "…" à liste`: a field’s value into a variable or a list."
                        texte "`{accent "…"}` met un mot en valeur ; `sans traduction` garde un nom propre identique dans toutes les langues." en anglais "`{accent "…"}` highlights a word; `sans traduction` keeps a proper noun the same in every language."
                        texte "`menu repliable`, `basculer theme`, `si theme est sombre`, l’animation `en cascade` et le lien « Aller au contenu » automatique." en anglais "`menu repliable`, `basculer theme`, `si theme est sombre`, the `en cascade` animation and the automatic “Skip to content” link."
                        texte "Les sous-titres prennent seuls le bon niveau dans une carte ; les ancres de l’en-tête et du pied sont vérifiées." en anglais "Subtitles get the right level on their own inside a card; header and footer anchors are checked."
                        texte "Le compilateur fonctionne aussi dans le navigateur : c’est lui qui fait tourner le bac à sable." en anglais "The compiler also runs in the browser: it powers the playground."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.0.4" sans traduction avec style "version-numero"
                        texte "30 octobre 2026" en anglais "October 30, 2026" avec style "version-date"
                    soustitre "La Licence Humalis" en anglais "The Humalis License"
                    liste :
                        texte "Humalis passe sous sa propre licence, la Licence Humalis 1.0 : l’utiliser est libre, le revendre ne l’est pas." en anglais "Humalis moves to its own license, the Humalis License 1.0: using it is free, reselling it is not."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.0.1 – 1.0.3" sans traduction avec style "version-numero"
                        texte "30 octobre 2026" en anglais "October 30, 2026" avec style "version-date"
                    soustitre "Le logo partout" en anglais "The logo everywhere"
                    liste :
                        texte "Le logo s’affiche dans la présentation sur npm et sur GitHub, en thème clair comme en thème sombre." en anglais "The logo shows in the README on npm and GitHub, in light and dark themes."
                bloc avec style "version" :
                    ligne avec style "version-tete" :
                        texte "1.0.0" sans traduction avec style "version-numero"
                        texte "30 octobre 2026" en anglais "October 30, 2026" avec style "version-date"
                    soustitre "La première version" en anglais "The first release"
                    liste :
                        texte "Un langage en français et son compilateur, pour cinq cibles : web, statique, mobile, bureau et serveur." en anglais "A language in French and its compiler, for five targets: web, static, mobile, desktop and server."
                        texte "Les commandes `nouveau`, `developper`, `compile` et `verifier`, et des messages d’erreur en français qui expliquent comment corriger." en anglais "The `nouveau`, `developper`, `compile` and `verifier` commands, and error messages that explain how to fix things."
                        texte "Un guide complet en français et en anglais." en anglais "A complete guide in French and English."
        colonne avec style "nouveautes-aside" et animation montee au defilement et en cascade :
            bloc avec style "aside-carte aside-vive" :
                texte "Version actuelle" en anglais "Current version" avec style "aside-etiquette"
                texte "1.7.4" sans traduction avec style "aside-version"
                texte "Pour mettre à jour Humalis sur ta machine :" en anglais "To update Humalis on your machine:"
                ligne avec style "install-command" :
                    texte "npm install -g humalis" sans traduction avec style "install-code"
                    bouton "Copier" en anglais "Copy" avec nom "copier-mise-a-jour" et style "copy-button"
                quand l'utilisateur clique sur "copier-mise-a-jour" :
                    copier "npm install -g humalis" avec message "Commande copiée" en anglais "Command copied"
            bloc avec style "aside-carte" :
                texte "En bref" en anglais "At a glance" avec style "aside-etiquette"
                ligne avec style "aside-chiffres" :
                    colonne avec style "aside-chiffre" :
                        texte "19" sans traduction avec style "aside-nombre"
